<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Dashboard</title>
    <link rel="stylesheet" href="/css/library.css">
    <link rel="stylesheet" href="/icon/css/all.min.css">
</head>

<body>
    <div class="library">
        <div class="heading">
            <h1>📚 School Library Management</h1>
            <p>Manage books, issue-return records, students borrowing history and late payments.</p>
        </div>
        <div class="add-new">
            <li>
                <h3> Library Management System</h3>

                <div class="icon">
                    <i class="fa-solid fa-book-open-reader"></i>
                </div>

                <p>
                    Explore and manage the school library system with an organized
                    platform for books, students, and library activities. Keep track
                    of resources and provide easy access to complete library services.
                </p>

                <ul>
                    <li>✔ Digital Library Records || ✔ Quick Book Search Facility</li>
                    <li>✔ Easy Book Management || ✔ Issue & Return Tracking</li>
                    <li>✔ Student Library Services || ✔ Organized Library Database</li>

                </ul>

                <a href="/library/add"> 📤Issue Book Now</a>
            </li>
        </div>

        <div class="issu-book">

            <div class="table-heading">
                <h2>📚 Currently Issued Books</h2>
                <p>
                    List of all books that are currently issued to students.
                </p>
            </div>


            <table>

                <thead>

                    <tr>
                        <th>S.No</th>
                        <th>Class Name</th>
                        <th>Roll Number</th>
                        <th>Book Name</th>
                        <th>Issue Date</th>
                        <th>Return Date</th>
                        <th>Issued By</th>
                        <th>Payment Status</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    <% issueBook.forEach((book,index)=>{ %>

                        <tr>

                            <td>
                                <%= index + 1 %>
                            </td>

                            <td>
                                <%= book.chooseclass %>
                            </td>

                            <td>
                                <%= book.rollno %>
                            </td>

                            <td>
                                <%= book.bookname %>
                            </td>

                            <td>
                                <%= book.issuedate %>
                            </td>

                            <td>
                                <%= book.returndate || "Not Returned" %>
                            </td>

                            <td>
                                <%= book.issueby %>
                            </td>
                            <td>

                                <% const today=new Date(); const returnDate=new Date(book.returndate); let fine=0;
                                    if(today> returnDate){

                                    const diffTime = today - returnDate;

                                    const lateDays = Math.floor(
                                    diffTime / (1000 * 60 * 60 * 24)
                                    );


                                    fine = Math.floor(lateDays / 7) * 50;

                                    }


                                    %>


                                    <% if(fine> 0){ %>

                                        💰 Fine ₹<%= fine %>

                                            <% } else { %>

                                                ✅ No Fine

                                                <% } %>


                            </td>
                            <td>
                                <form action="/library/reissue/<%= book._id %>" method="post"
                                    onsubmit="return confirm('Are you sure you want to re-issue this book?')">

                                    <button type="submit" class="reissue-btn">
                                        🔄 Re-Issue
                                    </button>

                                </form>
                                <form action="/library/delete/<%= book._id %>" method="post"
                                    onsubmit="return confirm(`Are you sure you went to delete this book record?`)">
                                    <button type="submit"> 🗑 Delete</button>
                                </form>
                            </td>

                        </tr>


                        <% }) %>


                </tbody>


            </table>
            <div class="table-heading">
                <p style="margin-top: 40px; font-size: 12px; color: black;">
                    Track all currently issued books with complete issue and return details.
                    Use the Re-Issue option to renew a book from the current date.
                    The system automatically extends the return date by 7 days and applies
                    a fine of ₹50 for every additional 7 days of delay.
                </p>
            </div>
        </div>
        <div class="library-info">
            <div class="div">
                <h2>📤Total Issued Books</h2>
                <p>
                    <%= totalBooks %>
                </p>
            </div>
            <div class="div">
                <h2>💰 Pending Fine</h2>
                <p> ₹<%= totalFine %>
                </p>
            </div>
        </div>
    </div>
    <a href="/" class="home-btn">← Back to Home</a>
</body>

</html>
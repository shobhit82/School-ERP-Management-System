<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Student Register</title>
</head>
<style>

    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }
    html {
        scroll-behavior: smooth;
    }
    /*=========================================
Scrollbar
=========================================*/
    ::-webkit-scrollbar {
        width: 12px;
    }
    ::-webkit-scrollbar-track {
        background: #edf4ff;
    }
    ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #2563eb, #1d4ed8);
        border-radius: 30px;
        border: 2px solid #edf4ff;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, #1d4ed8, #1e3a8a);
    }
    /*=========================================
Body
=========================================*/
    body {
        min-height: 100vh;
        padding: 40px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        background:
            linear-gradient(rgba(15, 23, 42, .72), rgba(15, 23, 42, .72)),
            url("https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1800&q=80");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }
    /*=========================================
Success Card
=========================================*/
    .container {
        width: 100%;
        max-width: 900px;
        background: rgba(255, 255, 255, .94);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 28px;
        padding: 60px 55px;
        text-align: center;
        box-shadow:
            0 25px 60px rgba(0, 0, 0, .28),
            0 0 0 1px rgba(255, 255, 255, .4);
        position: relative;
        overflow: hidden;
        animation: cardAnimation .8s ease;
    }
    /* Decorative Circle */
    .container::before {
        content: "";
        width: 220px;
        height: 220px;
        position: absolute;
        top: -80px;
        right: -80px;
        border-radius: 50%;
        background: rgba(37, 99, 235, .08);
    }
    .container::after {
        content: "";
        width: 180px;
        height: 180px;
        position: absolute;
        bottom: -70px;
        left: -70px;
        border-radius: 50%;
        background: rgba(22, 163, 74, .08);
    }
    /*=========================================
Success Icon
=========================================*/
    .container h1::before {
        content: "✔";
        display: flex;
        justify-content: center;
        align-items: center;
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: #16a34a;
        color: #fff;
        font-size: 42px;
        box-shadow: 0 12px 35px rgba(22, 163, 74, .35);
    }
    /*=========================================
Heading
=========================================*/
    .container h1 {
        font-size: 40px;
        font-weight: 700;
        color: #15803d;
        margin-bottom: 25px;
        line-height: 1.3;
    }
    /*=========================================
Paragraph
=========================================*/
    .container p {
        font-size: 19px;
        color: #475569;
        line-height: 2;
        max-width: 760px;
        margin: auto;
    }
    .container strong {
        color: #2563eb;
        font-weight: 700;
    }
    /*=========================================
Back Button
=========================================*/
    .home-btn {
        margin-top: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 15px 38px;
        border-radius: 50px;
        text-decoration: none;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        transition: .35s;
        box-shadow: 0 12px 30px rgba(37, 99, 235, .35);
    }
    .home-btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 18px 35px rgba(37, 99, 235, .45);
        background: linear-gradient(135deg, #1d4ed8, #1e40af);
    }
    /*=========================================
Animation
=========================================*/
    @keyframes cardAnimation {
        from {
            opacity: 0;
            transform: translateY(60px) scale(.9);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    /*=========================================
Responsive
=========================================*/
    @media(max-width:992px) {
        .container {
            padding: 50px 40px;
        }
        .container h1 {
            font-size: 34px;
        }
        .container p {
            font-size: 17px;
        }
    }
    @media(max-width:768px) {
        body {
            padding: 25px 15px;
        }
        .container {
            padding: 40px 25px;
            border-radius: 22px;
        }
        .container h1 {
            font-size: 28px;
        }
        .container h1::before {
            width: 75px;
            height: 75px;
            font-size: 35px;
        }
        .container p {
            font-size: 16px;
            line-height: 1.9;
        }
        .home-btn {
            width: 100%;
            padding: 16px;
        }
    }
    @media(max-width:480px) {
        .container {
            padding: 30px 20px;
        }
        .container h1 {
            font-size: 24px;
        }
        .container p {
            font-size: 15px;
        }
    }
</style>
<body>
    <div class="container">
        <h1>Registration Successfully Completed</h1>
        <p>
            🎉 Congratulations! <strong>
                <%= student.firstname %>
                    <%= student.lastname %>
            </strong>
            has been successfully enrolled in
            <strong>
                <%= student.chooseclass %>
            </strong>.
            The admission process has been completed successfully, and the student record is now available in the
            Student Management System.
        </p>
    </div>
    <a href="/dashboard" class="home-btn">← Back to Dashboard</a>
</body>
</html>
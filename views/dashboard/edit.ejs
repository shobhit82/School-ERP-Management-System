<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
</head>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    html {
        scroll-behavior: smooth;
    }

    /*=========================================
Scrollbar
=========================================*/

    ::-webkit-scrollbar {
        width: 12px;
    }

    ::-webkit-scrollbar-track {
        background: #eef2ff;
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #2563eb, #1d4ed8);
        border-radius: 20px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, #1d4ed8, #1e3a8a);
    }

    /*=========================================
Body
=========================================*/

    body {
        background: #f5f7fb;
        color: #1f2937;
        min-height: 100vh;
        padding: 40px 20px;
    }

    /*=========================================
Main Card
=========================================*/

    main {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
        background: #fff;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, .08);
        animation: fadeUp .8s ease;
    }

    /*=========================================
Heading
=========================================*/

    h2 {
        text-align: center;
        color: #1e40af;
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    h2::after {
        content: "";
        display: block;
        width: 100%;
        height: 4px;
        margin: 12px auto 35px;
        border-radius: 20px;
        background: linear-gradient(90deg, #2563eb, #06b6d4);
    }

    /*=========================================
Form Layout
=========================================*/

    form {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    form div {
        display: flex;
        flex-direction: column;
    }

    /*=========================================
Labels
=========================================*/

    label {
        font-size: 15px;
        font-weight: 600;
        color: #000000;
        margin-bottom: 8px;
    }

    /*=========================================
Input Fields
=========================================*/

    input,
    select,
    textarea {
        width: 100%;
        padding: 14px 16px;
        font-size: 15px;
        color: #1f2937;
        background: #ffffff;
        border: 2px solid #dbe4f0;
        border-radius: 10px;
        outline: none;
        transition: .35s ease;
    }

    textarea {
        resize: vertical;
        min-height: 120px;
    }

    input::placeholder,
    textarea::placeholder {
        color: #9ca3af;
    }

    input:hover,
    select:hover,
    textarea:hover {
        border-color: #60a5fa;
    }

    input:focus,
    select:focus,
    textarea:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 5px rgba(37, 99, 235, .12);
        transform: translateY(-2px);
    }

    /*=========================================
Buttons
=========================================*/

    form div:last-child {
        grid-column: 1 / -1;
        margin-top: 10px;
    }

    button {
        width: 100%;
        padding: 15px;
        border: none;
        outline: none;
        cursor: pointer;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        transition: .35s ease;
        letter-spacing: .5px;
    }

    button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(37, 99, 235, .25);
        background: linear-gradient(135deg, #1d4ed8, #0891b2);
    }

    button:active {
        transform: scale(.98);
    }

    /*=========================================
Optional Back Button
=========================================*/

    .back-btn {
        display: inline-block;
        margin-top: 18px;
        text-decoration: none;
        padding: 12px 24px;
        background: #111827;
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        transition: .3s;
    }

    .back-btn:hover {
        background: #000;
        transform: translateY(-3px);
    }

    /*=========================================
Animation
=========================================*/

    @keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(45px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

    /*=========================================
Form Animation
=========================================*/

    form div {
        animation: slideUp .6s ease;
    }

    @keyframes slideUp {

        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

    /*=========================================
Selection
=========================================*/

    ::selection {
        background: #2563eb;
        color: #fff;
    }

    /*=========================================
Input Autofill
=========================================*/

    input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
        -webkit-text-fill-color: #1f2937 !important;
    }

    /*=========================================
Tablet
=========================================*/

    @media(max-width:992px) {

        body {
            padding: 30px 18px;
        }

        main {
            max-width: 700px;
            padding: 35px;
        }

    }

    /*=========================================
Mobile
=========================================*/

    @media(max-width:768px) {

        form {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        main {
            padding: 30px 22px;
        }

        h2 {
            font-size: 30px;
        }

        label {
            font-size: 14px;
        }

        input,
        select,
        textarea {
            padding: 13px;
            font-size: 14px;
        }

        button {
            padding: 14px;
            font-size: 15px;
        }

    }

    /*=========================================
Small Mobile
=========================================*/

    @media(max-width:480px) {

        body {
            padding: 15px;
        }

        main {
            padding: 22px 18px;
            border-radius: 16px;
        }

        h2 {
            font-size: 24px;
        }

        h2::after {
            width: 60px;
            margin: 10px auto 25px;
        }

        label {
            font-size: 13px;
        }

        input,
        select,
        textarea {
            padding: 12px;
            font-size: 13px;
        }

        button {
            padding: 13px;
            font-size: 14px;
        }

        .back-btn {
            width: 100%;
            text-align: center;
        }

    }

    /*=========================================
Large Desktop
=========================================*/

    @media(min-width:1400px) {

        main {
            max-width: 900px;
        }

    }
</style>

<body>

    <main>
        <h2>Edit Student Record</h2>
        <form action="/dashboard/update/<%=student._id%>" method="post">
            <div style="background: linear-gradient(135deg, #bcd0fa, #a5e6f1); font-weight: 900; text-align: center; height: 50px; line-height: 50px; box-sizing: border-box; border-radius: 10px;">
                <label for="" >Roll Number:  <%= student.rollno %>  </label>
            </div>
            <div style="background: linear-gradient(135deg, #bcd0fa, #a5e6f1); font-weight: 900; text-align: center; height: 50px; line-height: 50px; box-sizing: border-box; border-radius: 10px;">
                <label for=""><%= student.chooseclass %></label>
            </div>
            <div>
                <label for="">First Name</label>
                <input type="text" name="firstname" value="<%= student._firstname%>" placeholder="Enter First Name"
                    required id="">
            </div>
            <div>
                <label for="">Last Name</label>
                <input type="text" name="lastname" value="<%= student._lastname%>" placeholder="Enter Last Name"
                    required id="">
            </div>
            <div>
                <label for="">Date Of Birth</label>
                <input type="date" name="dob" value="<%= student._dob%>" required id="">
            </div>
            <div>
                <label for="">Mobile Number</label>
                <input type="text" name="fathernumber" value="<%= student._fathernumber%>"
                    placeholder="Enter Mobile Number" required id="">
            </div>
            <div>
                <label for="">Email Address</label>
                <input type="email" name="email" value="<%= student._email %>" placeholder="Email Address" required="">
            </div>
            <div>
                <label for="">Full Address</label>
                <input type="text" name="address" value="<%= student._address%>" placeholder="Full Address" required
                    id="">
            </div>
            <div>
                <button type="submit">Update Student</button>
            </div>
        </form>
        <a href="/dashboard/class/<%= student.chooseclass %>" class="back-btn">
            ← Back to Student List
        </a>
    </main>
</body>

</html>
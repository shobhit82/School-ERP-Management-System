<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Details</title>
    <link rel="stylesheet" href="/css/studenyt-info.css">
</head>

<body>
    <div class="conatiner">
        <header>
            <h1>Student Details</h1>
            <a href="/dashboard/add">+ Add New Student</a>
        </header>
        <section>
            <div class="personal-info">
                <p><b>Admission Number:</b> <%= student.admission %>
                </p>
                <p><b>First Name:</b> <%= student.firstname %>
                </p>
                <p><b>Last Name:</b> <%= student.lastname %>
                </p>
                <p><b>Date Of Birth: </b><%= student.dob %>
                </p>
            </div>
            <div class="acadmice-info">
                <p><b>Class:</b> <%= student.chooseclass %>
                </p>
                <p><b>Roll Number:</b> <%= student.rollno %>
                </p>
                <p>
                    <b>Admission Date:</b> <%= student.admissiondate %>
                </p>
                <p><b>Academic Session:</b> <%= student.session %>
                </p>
            </div>
            <div class="parent-info">
                <p><b>Father's Name:</b> <%= student.fathername %>
                </p>
                <p><b>Mother's Name:</b> <%= student.mothername %>
                </p>
                <p><b>Father;s Mobile Number:</b> <%= student.fathernumber %>
                </p>
                <p><b>Mother's Mobile Number:</b> <%= student.mothernumber %>
                </p>
                <p><b>Parent Email:</b> <%= student.email %>
                </p>
                <p>
                    <b>Occupation: </b><%= student.occupation %>
                </p>
                <p><b>Annual Income: </b><%= student.income %> 
                </p>
            </div>
            <div class="address-info">
                <p><b>Country:</b> <%=student.country %>
                </p>
                <p><b>State:</b> <%=student.state %>
                </p>
                <p><b>City:</b> <%=student.city %>
                </p>
                <p><b>Pin Code:</b> <%=student.pincode %>
                </p>
                <p><b>Full Address:</b> <%=student.address %>
                </p>
            </div>
            <a href="/dashboard" class="home-btn">← Back to Dashboard</a>
        </section>
    </div>
</body>

</html>
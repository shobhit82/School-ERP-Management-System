<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Add New Student</title>
    <link rel="stylesheet" href="/css/addNew.css">
</head>

<body>
    <main>
        <h2> New Admission</h2>

        <p>
            Add newly admitted students with complete academic and personal information.
            The system will automatically organize records according to the selected class.
        </p>

        <form action="/dashboard/addNew" method="post">
            <div class="personal-info">
                <h2>👤 1. Personal Information</h2>
                <div>
                    <label for="">Admission Number</label>
                    <input type="text" name="admission" placeholder="Admission Number" required id="">
                </div>
                <div>
                    <label for="">First Name</label>
                    <input type="text" name="firstname" placeholder="Enter First Name" required id="">
                </div>
                <div>
                    <label for="">Last Name</label>
                    <input type="text" name="lastname" placeholder="Enter Last Name" required id="">
                </div>
                <div>
                    <label for="">Date Of Birth</label>
                    <input type="date" name="dob" required id="">
                </div>
            </div>

            <div class="acadmice-info">
                <h2>🎓 2. Academic Information</h2>
                <div>
                    <label for="">Class</label>
                    <select name="chooseclass" required id="">
                        <option value="">--Select--</option>
                        <option value="class 1">Class 1</option>
                        <option value="class 2">Class 2</option>
                        <option value="class 3">Class 3</option>
                        <option value="class 4">Class 4</option>
                        <option value="class 5">Class 5</option>
                        <option value="class 6">Class 6</option>
                        <option value="class 7">Class 7</option>
                        <option value="class 8">Class 8</option>
                    </select>
                </div>
                <div>
                    <label for="">Roll Number</label>
                    <input type="text" name="rollno" required placeholder="Enter Roll Number" id="">
                </div>
                <div>
                    <label for="">Admission Date</label>
                    <input type="datetime-local" name="admissiondate" required id="">
                </div>
                <div>
                    <label for="">Acadmice Session</label>
                    <input type="text" name="session" required value="2026-2027" readonly id="">
                </div>

            </div>

            <div class="parent-info">
                <h2>👨‍👩‍👦 3. Parent / Guardian Details</h2>
                <div>
                    <label for="">Father's Name</label>
                    <input type="text" name="fathername" required placeholder="Enter Father's Name" id="">
                </div>
                <div>
                    <label for="">Mother's Name</label>
                    <input type="text" name="mothername" required placeholder="Enter Mother's Name" id="">
                </div>
                <div>
                    <label for="">Father's Mobile Number</label>
                    <input type="text" name="fathernumber" required placeholder="Enter Mobile Number" id="">
                </div>
                <div>
                    <label for="">Mother's Mobile Number</label>
                    <input type="text" name="mothernumber" required placeholder="Enter Mobile Number" id="">
                </div>
                <div>
                    <label for="">Parent Email</label>
                    <input type="email" name="email" required placeholder=" Email Address" id="">
                </div>
                <div>
                    <label for="">Occupation</label>
                    <input type="text" name="occupation" required placeholder="Occupation" id="">
                </div>
                <div>
                    <label for="">Annual Income (optional)</label>
                    <select id="income" name="income" required>
                        <option value="">-- Select Annual Income --</option>
                        <option value="below-50000">Below ₹50,000</option>
                        <option value="50000-100000">₹50,000 – ₹1,00,000</option>
                        <option value="100000-300000">₹1,00,000 – ₹3,00,000</option>
                        <option value="300000-500000">₹3,00,000 – ₹5,00,000</option>
                        <option value="500000-800000">₹5,00,000 – ₹8,00,000</option>
                        <option value="800000-1000000">₹8,00,000 – ₹10,00,000</option>
                        <option value="1000000-1500000">₹10,00,000 – ₹15,00,000</option>
                        <option value="1500000-2000000">₹15,00,000 – ₹20,00,000</option>
                        <option value="above-2000000">Above ₹20,00,000</option>
                        <option value="prefer-not-to-say">Prefer Not to Say</option>
                    </select>
                </div>
            </div>

            <div class="address-info">
                <h2>📍 4. Address Details</h2>
                <div>
                    <label for="">Country</label>
                    <select id="country" name="country" required>
                        <option value="">-- Select Country --</option>
                        <option value="India">India</option>
                        <option value="United States">United States</option>
                        <option value="United Kingdom">United Kingdom</option>
                        <option value="Canada">Canada</option>
                        <option value="Australia">Australia</option>
                        <option value="New Zealand">New Zealand</option>
                        <option value="Germany">Germany</option>
                        <option value="France">France</option>
                        <option value="Italy">Italy</option>
                        <option value="Spain">Spain</option>
                    </select>
                </div>
                <div>
                    <label for="">State</label>

                    <select id="state" name="state" required>
                        <option value="">-- Select State --</option>
                        <option value="Uttar Pradesh">Uttar Pradesh</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Haryana">Haryana</option>
                        <option value="Punjab">Punjab</option>
                        <option value="Rajasthan">Rajasthan</option>
                        <option value="Maharashtra">Maharashtra</option>
                        <option value="Gujarat">Gujarat</option>
                        <option value="Madhya Pradesh">Madhya Pradesh</option>
                        <option value="Bihar">Bihar</option>
                        <option value="Uttarakhand">Uttarakhand</option>
                    </select>
                </div>
                <div>
                    <label for="city">City</label>

                    <select id="city" name="city" required>
                        <option value="">-- Select City --</option>
                        <option value="Delhi">Delhi</option>
                        <option value="Mumbai">Mumbai</option>
                        <option value="Bengaluru">Bengaluru</option>
                        <option value="Hyderabad">Hyderabad</option>
                        <option value="Chennai">Chennai</option>
                        <option value="Kolkata">Kolkata</option>
                        <option value="Lucknow">Lucknow</option>
                        <option value="Jaipur">Jaipur</option>
                        <option value="Ahmedabad">Ahmedabad</option>
                        <option value="Muzaffarnagar">Muzaffarnagar</option>
                    </select>
                </div>
                <div>
                    <label for="">Pin Code</label>
                    <input type="text" name="pincode" required placeholder="Pin Code" id="">
                </div>
                <div>
                    <label for="">Full Address</label>
                    <input type="text" name="address" required placeholder="Enter Full Address" id="">
                </div>
            </div>

            <div>
                <button type="submit">Save Student</button>
                <button type="reset">Reset</button>
            </div>

        </form>

        <a href="/dashboard" class="home-btn">← Back to Dashboard</a>

    </main>
</body>

</html>
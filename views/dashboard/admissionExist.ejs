<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Already Exist</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #edf4ff;
        }

        ::-webkit-scrollbar-thumb {
            background: #2563eb;
            border-radius: 20px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #1d4ed8;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: linear-gradient(135deg, #eef5ff, #ffffff, #e7f1ff);
        }

        /*=========================================
 Container
=========================================*/
        .container {
            width: 100%;
            max-width: 650px;
        }

        /*=========================================
 Card
=========================================*/
        .card {
            background: rgba(255, 255, 255, .95);
            border-radius: 25px;
            padding: 60px 45px;
            text-align: center;
            box-shadow: 0 20px 45px rgba(0, 0, 0, .08);
            border-top: 8px solid #2563eb;
            transition: .4s;
            animation: fadeUp .8s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 55px rgba(0, 0, 0, .15);
        }

        /*=========================================
 Icon
=========================================*/
        .icon {
            width: 120px;
            height: 120px;
            margin: auto;
            border-radius: 50%;
            background: #dbeafe;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 60px;
            margin-bottom: 30px;
            animation: float 3s ease-in-out infinite;
        }

        /*=========================================
 Heading
=========================================*/
        h1 {
            color: #1e3a8a;
            font-size: 38px;
            margin-bottom: 20px;
        }

        p {
            color: #64748b;
            font-size: 17px;
            line-height: 1.8;
        }

        /*=========================================
 Animations
=========================================*/
        @keyframes float {
            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }

            100% {
                transform: translateY(0);
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /*=========================================
 Tablet
=========================================*/
        @media(max-width:768px) {
            body {
                padding: 25px;
            }

            .card {
                padding: 45px 30px;
            }

            .icon {
                width: 100px;
                height: 100px;
                font-size: 50px;
            }

            h1 {
                font-size: 30px;
            }

            p {
                font-size: 16px;
            }
        }

        /*=========================================
 Mobile
=========================================*/
        @media(max-width:480px) {
            body {
                padding: 15px;
            }

            .card {
                padding: 35px 20px;
                border-radius: 18px;
            }

            .icon {
                width: 80px;
                height: 80px;
                font-size: 40px;
                margin-bottom: 20px;
            }

            h1 {
                font-size: 24px;
            }

            p {
                font-size: 15px;
                line-height: 1.7;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="card">
            <div class="icon">⚠️</div>
            <h1>Admission Number Already Registered</h1>
            <p>
                The admission number you entered is already registered
                in the database. Please enter a unique admission number
                or check the existing student record before proceeding.
            </p>
        </div>
    </div>
    <script>
        setTimeout(() => {
            window.location.href = "/dashboard/add";
        }, 4000);
    </script>
</body>

</html>